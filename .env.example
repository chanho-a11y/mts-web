# Supabase (mtspace-commerce / ap-northeast-2)
NEXT_PUBLIC_SUPABASE_URL=https://apiskyivlvebpvvxfejq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Server-only (DO NOT commit; set in Vercel env)
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://mtspace.coffee

# Payments
# PAYMENTS_TEST_MODE 동작:
#   true  → 모든 PG 우회, 주문 자동 승인(키 없이 주문→메일 플로우만 검증). 실PG는 호출 안 됨.
#   false → 실PG 경로. 키 있는 PG만 결제창 진행, 키 없는 PG는 '주문생성·결제대기'.
#           페이팔 sandbox 실검증하려면 false + PAYPAL_ENV=sandbox 로 둘 것.
# ※ 키는 반드시 단일 선언(중복 금지).
PAYMENTS_TEST_MODE=false
# 환율: 실시간(lib/fx.ts, 매일 갱신=주문일 환율). 마진 버퍼 FX_MARKUP_PCT(%)만 조정.
#   effectiveRate = 시세 × (1 − 버퍼/100). 기본 3(월 변동 ~1σ/페이팔 환전 스프레드 대비, D-036).
FX_MARKUP_PCT=3
# 이니시스 표준결제(INIStdPay)
INICIS_MID=
INICIS_SIGNKEY=
# 모바일 표준결제 금액 위변조 방지 HashKey (가맹점관리자 > 상점정보 > 계약정보 > KEY정보)
# 미설정 시 모바일 결제는 amt_hash 없이 진행되며, 승인금액 대조(서버)로만 검증합니다.
INICIS_MHASHKEY=
# 카카오페이(online v1)
KAKAOPAY_CID=
KAKAOPAY_SECRET=
# 페이팔(Orders v2). live 전환 시 PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENV=sandbox

# Email — Gmail SMTP(앱 비밀번호) 우선. 없으면 Resend → webhook 순 폴백.
GMAIL_USER=chanho@mtspace.coffee
GMAIL_APP_PASSWORD=
EMAIL_FROM=MTSPACE COFFEE <chanho@mtspace.coffee>
RESEND_API_KEY=
EMAIL_WEBHOOK_URL=

# Cron (이메일 자동화 인증) — Vercel Cron 또는 외부 스케줄러
CRON_SECRET=

# Integrations (P6)
META_COMMERCE_TOKEN=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# 메타 쇼핑 / 구글 머천트 — 피드 URL(/feed/shopping.xml) 등록만으로도 동작.
# 아래는 (선택) 실시간 API 동기화용. 설정 시 마케팅 페이지에 '연동됨' 표시.
META_CATALOG_ID=
META_ACCESS_TOKEN=
GOOGLE_MERCHANT_ID=

# 블로그 실시간 리서치 — 네이버 검색 API(무료). 개발자센터(developers.naver.com)에서
# 애플리케이션 등록 후 발급. 미설정 시 블로그는 제품정보+지식베이스 기반으로만 생성(리서치 버튼 비활성).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
